{
  "appId": "com.deliveryosapp.client",
  "appName": "DeliveryOS",
  "webDir": "www",
  "server": {
    "url": "https://deliveryosapp.com/stores",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.pagoplux.com",
      "*.cardinalcommerce.com"
    ]
  },
  "plugins": {
    "App": {
      "disableBackButtonHandler": true
    }
  },
  "ios": {
    "contentInset": "never",
    "appendUserAgent": "DeliveryOSClient/ios-1"
  }
}
